rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserData() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isUserActive() {
      return isSignedIn() && 
             (!hasUserData() || getUserData().isActive == true);
    }

    function isSuperAdmin() {
      return isSignedIn() && hasUserData() && isUserActive() && getUserData().role in ['super_admin', 'Superadmin'];
    }

    function isSameOrg(resourceOrgId) {
      return isSignedIn() && hasUserData() && isUserActive() && getUserData().organizationId == resourceOrgId;
    }

    function isOrgAdmin() {
      return isSignedIn() && hasUserData() && isUserActive() && getUserData().role in ['org_admin', 'super_admin', 'Admin', 'Superadmin', 'Manager', 'OrgOwner'];
    }

    function isOrgOwner(orgId) {
      return isSignedIn() && hasUserData() && isUserActive() && getUserData().role == 'OrgOwner' && getUserData().organizationId == orgId;
    }

    match /organizations/{orgId} {
      allow read: if isSuperAdmin() || (isUserActive() && hasUserData() && getUserData().organizationId == orgId);
      allow create: if isSignedIn();
      allow update: if isSuperAdmin() || (
        isUserActive() && hasUserData() && getUserData().organizationId == orgId && (
          isOrgAdmin() || 
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscription', 'aiUsage']) &&
            request.resource.data.get('subscription', {}).diff(resource.data.get('subscription', {})).affectedKeys().hasOnly(['aiUsed']) &&
            request.resource.data.get('aiUsage', {}).diff(resource.data.get('aiUsage', {})).affectedKeys().hasOnly(['currentUsage'])
          )
        )
      );
      allow delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow create: if isSignedIn() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (request.resource.data.organizationId == getUserData().organizationId && isOrgAdmin())
      );
      
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        resource.data.email == request.auth.token.email ||
        isSameOrg(resource.data.organizationId)
      );

      // KEY FIX: Removed 'organizationId' from the blocked fields list.
      // This allows the payment verification flow to set organizationId after payment.
      // Only 'role' and 'email' are protected from self-modification.
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && 
         isUserActive() &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email'])) ||
        isSuperAdmin() ||
        (isOrgAdmin() && isSameOrg(resource.data.organizationId) && 
         !(request.resource.data.role in ['super_admin', 'Superadmin'])) ||
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['organizationId', 'paymentStatus', 'subscriptionStatus', 'planId', 'billingCycle', 'updatedAt', 'pendingOrderId', 'pendingPlanId', 'pendingBillingCycle'])
      );

      allow delete: if isSuperAdmin() || (
        isSignedIn() &&
        resource != null &&
        resource.data.email == request.auth.token.email &&
        resource.data.invited == true
      );
    }

    match /bugs/{bugId} {
      allow read: if isSuperAdmin() || 
                  isSameOrg(resource.data.organizationId) || 
                  (resource.data.projectId != null && get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.isPublic == true);
      allow create: if isSignedIn() && isSameOrg(request.resource.data.organizationId);
      allow update: if isSuperAdmin() || (
        isSameOrg(resource.data.organizationId) && 
        isSameOrg(request.resource.data.organizationId)
      );
      allow delete: if isSuperAdmin() || (
        isSameOrg(resource.data.organizationId) && 
        isOrgAdmin()
      );
    }
    
    match /projects/{projectId} {
      allow read: if isSuperAdmin() 
                  || isSameOrg(resource.data.organizationId) 
                  || resource.data.isPublic == true
                  || (isSignedIn() && isUserActive() && request.auth.uid in resource.data.assignedUsers);
      allow create: if isSignedIn() && (isSameOrg(request.resource.data.organizationId) || isOrgAdmin());
      allow update: if isSuperAdmin() || (
        isSameOrg(resource.data.organizationId) && 
        isSameOrg(request.resource.data.organizationId)
      ) || (isOrgAdmin() && request.auth.uid in resource.data.assignedUsers);
      allow delete: if isSuperAdmin() || (
        isSameOrg(resource.data.organizationId) && 
        isOrgAdmin()
      ) || (isOrgAdmin() && request.auth.uid in resource.data.assignedUsers);
    }

    match /notifications/{notifId} {
      allow read: if isSignedIn() && isUserActive() && (
        resource.data.userId == request.auth.uid || isSuperAdmin()
      );
      allow create: if isSignedIn() && isUserActive();
      allow update, delete: if isSignedIn() && isUserActive() && (
        resource.data.userId == request.auth.uid || isSuperAdmin()
      );
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /invitations/{inviteId} {
      // KEY FIX: Allow a newly signed-in user to read invitations sent to their email.
      // This is needed during the signup invite-lookup phase.
      allow read: if isSignedIn() && (
        isSuperAdmin() || 
        (isUserActive() && hasUserData() && resource.data.organizationId == getUserData().organizationId) ||
        resource.data.email == request.auth.token.email
      );
      allow create: if isSignedIn() && isOrgAdmin() && request.resource.data.organizationId == getUserData().organizationId;
      allow update, delete: if isSignedIn() && (
        isSuperAdmin() || 
        (isOrgAdmin() && isSameOrg(resource.data.organizationId)) || 
        (isUserActive() && request.auth.uid == resource.data.invitedBy)
      );
    }

    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if isSignedIn();
    }

    match /org_audit_logs/{logId} {
      allow read: if isSuperAdmin() || (isSignedIn() && hasUserData() && isUserActive() && getUserData().role == 'OrgOwner' && resource.data.organizationId == getUserData().organizationId);
      allow create: if isSignedIn() && isUserActive() && (isSuperAdmin() || (hasUserData() && getUserData().role == 'OrgOwner' && request.resource.data.organizationId == getUserData().organizationId) || isOrgAdmin());
      allow update, delete: if false;
    }

    // ── Payment Collections ──────────────────────────────────────────────────

    match /payments/{paymentId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isSuperAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if false;
    }

    match /invoices/{invoiceId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        isSuperAdmin() ||
        (hasUserData() && resource.data.organizationId == getUserData().organizationId && isOrgAdmin())
      );
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid);
      allow update, delete: if isSuperAdmin();
    }

    match /webhook_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    // ── AI QA Agent Collections ──────────────────────────────────────────────

    match /agent_runs/{runId} {
      allow read: if isSuperAdmin() || isSameOrg(resource.data.organizationId);
      allow create: if isSignedIn() && isSameOrg(request.resource.data.organizationId);
      allow update: if isSuperAdmin() || isSameOrg(resource.data.organizationId);
      allow delete: if isSuperAdmin() || (
        isSameOrg(resource.data.organizationId) && isOrgAdmin()
      );

      // Test results — written only by backend service, readable by org members
      match /tests/{testId} {
        allow read: if isSuperAdmin() || isSameOrg(
          get(/databases/$(database)/documents/agent_runs/$(runId)).data.organizationId
        );
        allow write: if false;  // Only written by backend/Cloud Run worker
      }
    }

    match /applications/{appId} {
      allow read: if isSuperAdmin() || isSameOrg(resource.data.organizationId);
      allow create: if isSignedIn() && isSameOrg(request.resource.data.organizationId);
      allow update, delete: if isSuperAdmin() || (isSameOrg(resource.data.organizationId) && isOrgAdmin());
    }
    
    match /website_scans/{scanId} {
      allow read: if isSuperAdmin() || isSameOrg(resource.data.organizationId);
      allow create, update: if isSignedIn() && isSameOrg(request.resource.data.organizationId);
      allow delete: if isSuperAdmin();
    }
    
    match /generated_test_cases/{testId} {
      allow read: if isSuperAdmin() || isSameOrg(resource.data.organizationId);
      allow create, update: if isSignedIn() && isSameOrg(request.resource.data.organizationId);
      allow delete: if isSuperAdmin() || (isSameOrg(resource.data.organizationId) && isOrgAdmin());
    }

    match /executions/{executionId} {
      allow read: if isSuperAdmin() || isSameOrg(resource.data.organizationId);
      allow create: if isSignedIn() && isSameOrg(request.resource.data.organizationId);
      allow update: if isSuperAdmin() || isSameOrg(resource.data.organizationId);
      allow delete: if isSuperAdmin() || (isSameOrg(resource.data.organizationId) && isOrgAdmin());

      match /execution_logs/{logId} {
        allow read: if isSuperAdmin() || isSameOrg(get(/databases/$(database)/documents/executions/$(executionId)).data.organizationId);
        allow write: if false; // System writes only
      }
    }

    match /screenshots/{mediaId} {
      allow read: if isSuperAdmin() || isSameOrg(resource.data.organizationId);
      allow create: if isSignedIn() && isSameOrg(request.resource.data.organizationId);
      allow delete: if isSuperAdmin();
      allow update: if false;
    }

    match /videos/{mediaId} {
      allow read: if isSuperAdmin() || isSameOrg(resource.data.organizationId);
      allow create: if isSignedIn() && isSameOrg(request.resource.data.organizationId);
      allow delete: if isSuperAdmin();
      allow update: if false;
    }

    match /ai_conversations/{conversationId} {
      allow read, update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      
      match /messages/{messageId} {
        allow read, create: if isSignedIn() && get(/databases/$(database)/documents/ai_conversations/$(conversationId)).data.uid == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}